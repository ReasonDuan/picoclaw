#!/bin/bash
set -u

LOG_FILE="${TRIM_PKGVAR}/launcher.log"
PID_FILE="${TRIM_PKGVAR}/launcher.pid"
APP_DIR="${TRIM_APPDEST}/bin"
PORT=18800

# Include the bundled runtime first, then the fnOS host tools. This allows
# PicoClaw child processes to resolve sh and other system commands by name.
export PATH="${TRIM_APPDEST}/runtime/bin:${TRIM_APPDEST}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

export PICOCLAW_HOME="${PICOCLAW_HOME:-${TRIM_PKGVAR}}"
export PICOCLAW_BINARY="${APP_DIR}/picoclaw"
export PICOCLAW_CONFIG="${PICOCLAW_CONFIG:-${PICOCLAW_HOME}/config.json}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

check_process() {
    local pid="$1"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

status_app() {
    if [ -r "$PID_FILE" ]; then
        local pid
        pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
        if check_process "$pid"; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

start_app() {
    if status_app; then
        return 0
    fi

    mkdir -p "$(dirname "$LOG_FILE")" "$PICOCLAW_HOME"
    log_msg "Starting PicoClaw launcher on port ${PORT}"

    (
        cd "$APP_DIR" || exit 1
        exec "$APP_DIR/picoclaw-launcher" \
            -console \
            -no-browser \
            -public \
            -host 0.0.0.0 \
            -port "$PORT" \
            "$PICOCLAW_CONFIG"
    ) >> "$LOG_FILE" 2>&1 &

    local pid=$!
    printf '%s' "$pid" > "$PID_FILE"

    sleep 2
    if ! check_process "$pid"; then
        rm -f "$PID_FILE"
        log_msg "Launcher exited during startup"
        return 1
    fi

    return 0
}

stop_app() {
    if [ ! -r "$PID_FILE" ]; then
        return 0
    fi

    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if ! check_process "$pid"; then
        rm -f "$PID_FILE"
        return 0
    fi

    log_msg "Stopping PicoClaw launcher PID=${pid}"
    kill -TERM "$pid" 2>/dev/null || true

    local count=0
    while check_process "$pid" && [ "$count" -lt 15 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "$pid"; then
        log_msg "Launcher did not stop gracefully, sending KILL"
        kill -KILL "$pid" 2>/dev/null || true
    fi

    rm -f "$PID_FILE"
    return 0
}

case "$1" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    status)
        if status_app; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
        exit 1
        ;;
esac
